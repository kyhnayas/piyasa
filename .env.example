# ==========================================
# Piyasa (piyasa.work)
# Environment Variables Configuration
# ==========================================
# NOT: Bu dosya şablondur. Gerçek gizli anahtarları .env.local içerisine yazın.
# Asla .env veya .env.local dosyalarını Git'e commitlemeyin.

# ------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------
# Local Docker veya Cloud PostgreSQL (Neon / Supabase) Bağlantı Dizesi
DATABASE_URL="postgresql://piyasa_user:piyasa_secret_password@localhost:5432/piyasa_db?schema=public"

# ------------------------------------------
# 2. SITE & CANONICAL URLS
# ------------------------------------------
# Production: https://piyasa.work | Local: http://localhost:3000
SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ------------------------------------------
# 3. GHOST CMS INTEGRATION
# ------------------------------------------
# Ghost CMS headless backend URL (Local Docker: http://localhost:2368 | Prod: https://ghost.piyasa.work)
GHOST_URL="http://localhost:2368"
# Ghost Admin -> Integrations panelinden oluşturulacak Content API anahtarı
GHOST_CONTENT_API_KEY="your_ghost_content_api_key_here"
# Ghost Admin API anahtarı (newsletter / webhook senkronizasyonu için)
GHOST_ADMIN_API_KEY="your_ghost_admin_api_key_here"

# ------------------------------------------
# 4. MCP (MODEL CONTEXT PROTOCOL) & GEMINI SPARK
# ------------------------------------------
MCP_BASE_URL="http://localhost:4000"
# Spark / MCP sunucu isteklerini doğrulamak için güçlü rastgele Bearer token (min. 32 karakter)
MCP_AUTH_SECRET="your_secure_mcp_bearer_token_min_32_chars"
MCP_PORT=4000

# ------------------------------------------
# 5. SECURITY & AUTHENTICATION
# ------------------------------------------
# Admin Panel Giriş Bilgileri & Oturum Güvenliği
ADMIN_USER="kyhnayas"
ADMIN_PASS="1453Kayhan."
ADMIN_JWT_SECRET="generate_a_random_32_byte_hex_string_for_production"
AUTH_SECRET="generate_a_random_32_byte_hex_string_for_production"
NEXTAUTH_URL="http://localhost:3000"
EMDASH_URL="http://127.0.0.1:4321"

# Rate Limiting (Redis / Upstash - Opsiyonel local memory fallback destekler)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Bot & Spam Koruması (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ------------------------------------------
# 6. ANALYTICS & MONITORING
# ------------------------------------------
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=""
NEXT_PUBLIC_SEARCH_CONSOLE_VERIFICATION=""

# ------------------------------------------
# 7. AI MODERATION (Gemini API)
# ------------------------------------------
# Maaş bildirimlerindeki küfür, spam, PII ve manipülasyon kontrolü için
GEMINI_API_KEY=""
