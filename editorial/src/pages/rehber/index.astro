---
import { getEmDashCollection, getTermsForEntries } from "emdash";
import Base from "../../layouts/Base.astro";
import { getReadingTime } from "../../utils/reading-time";

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: posts,
	cacheHint,
} = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const tagsByEntry = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"tag",
);

const postsWithTags = posts.map((post) => ({
	post,
	tags: tagsByEntry.get(post.data.id) ?? [],
}));

const formatDate = (date: Date) =>
	date.toLocaleDateString("tr-TR", {
		year: "numeric",
		month: "long",
		day: "numeric",
	});
---

<Base title="Kariyer ve Maaş Rehberleri | Piyasa" description="Türkiye iş piyasası, meslek maaşları, kariyer tavsiyeleri ve sektör analizleri rehberi.">
	<div class="posts-page" style="max-width: 1000px; margin: 0 auto; padding: 2rem 1rem;">
		<header class="page-header" style="margin-bottom: 2.5rem; border-bottom: 1px solid var(--color-border); padding-bottom: 1.5rem;">
			<nav style="font-size: 0.875rem; margin-bottom: 0.75rem;">
				<a href="/" style="color: var(--color-text-secondary); text-decoration: none;">Piyasa Ana Sayfa</a>
				<span style="margin: 0 0.5rem; color: var(--color-muted);">/</span>
				<span style="color: var(--color-text);">Rehber</span>
			</nav>
			<h1 class="page-title" style="font-size: 2.25rem; font-weight: 800; letter-spacing: -0.025em; margin: 0 0 0.5rem 0;">Kariyer &amp; Maaş Rehberleri</h1>
			<p class="page-description" style="color: var(--color-text-secondary); font-size: 1.125rem; margin: 0;">
				Türkiye iş piyasasında doğru kariyer adımları, maaş dinamikleri ve profesyonel gelişim rehberi.
			</p>
		</header>

		{
			posts.length === 0 ? (
				<p class="empty">Henüz yayınlanmış rehber bulunmuyor.</p>
			) : (
				<div class="posts-list" style="display: grid; gap: 1.5rem;">
					{postsWithTags.map(({ post, tags }) => (
						<article class="post-item" style="padding: 1.5rem; border-radius: 12px; border: 1px solid var(--color-border); background: var(--color-bg-subtle); transition: transform 0.2s, box-shadow 0.2s;">
							<div class="post-meta" style="font-size: 0.8125rem; color: var(--color-text-secondary); margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
								{post.data.publishedAt && (
									<time datetime={typeof post.data.publishedAt === 'string' ? post.data.publishedAt : post.data.publishedAt.toISOString()}>
										{formatDate(typeof post.data.publishedAt === 'string' ? new Date(post.data.publishedAt) : post.data.publishedAt)}
									</time>
								)}
								<span>•</span>
								<span>{getReadingTime(post.data.content)}</span>
							</div>
							<h2 class="post-title" style="margin: 0 0 0.75rem 0; font-size: 1.375rem; font-weight: 700;">
								<a href={`/rehber/${post.data.slug}`} style="color: var(--color-text); text-decoration: none;">
									{post.data.title}
								</a>
							</h2>
							{post.data.excerpt && (
								<p class="post-excerpt" style="color: var(--color-text-secondary); line-height: 1.6; margin: 0 0 1rem 0;">
									{post.data.excerpt}
								</p>
							)}
							<div style="display: flex; justify-content: space-between; align-items: center;">
								<div class="post-tags" style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
									{tags.map((tag) => (
										<span style="font-size: 0.75rem; padding: 0.2rem 0.6rem; border-radius: 9999px; background: var(--color-border-subtle); color: var(--color-text-secondary);">
											#{tag.name}
										</span>
									))}
								</div>
								<a href={`/rehber/${post.data.slug}`} style="font-weight: 600; font-size: 0.875rem; color: #2563eb; text-decoration: none;">
									Rehberi Oku &rarr;
								</a>
							</div>
						</article>
					))}
				</div>
			)
		}
	</div>
</Base>
